# ==============================================================================
# Nexus Core Enterprise Platform - Environment Configuration Template
# Copy this file to .env and customize values for your deployment environment.
# DO NOT commit production .env files with real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Gateway Configuration (HTTP / REST)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
GRPC_TARGET=localhost:50051

# In production, generate a secure 256-bit random key:
# e.g., openssl rand -base64 32
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ------------------------------------------------------------------------------
# 2. Internal Microservice Configuration (gRPC)
# ------------------------------------------------------------------------------
GRPC_PORT=50051

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=usermanagement
DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# 4. Redis Distributed Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Frontend Web Application (Vite / React)
# ------------------------------------------------------------------------------
# For local dev: http://localhost:8080/api/v1
# For Docker Nginx deployment: /api/v1 (relative path routed via Nginx reverse proxy)
VITE_API_URL=http://localhost:8080/api/v1
VITE_HEALTH_URL=http://localhost:8080/health
